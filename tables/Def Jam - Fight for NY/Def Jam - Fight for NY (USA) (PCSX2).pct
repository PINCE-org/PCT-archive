{"version": 3, "notes": "- Implement BASE Code : Just Freeze PCSX2 RAM Detector to trigger in BASE\n\n- Press Shift + F10 (detach mode) after select process to stop froze PINCE effect.\n\n- For AppImage PCSX2, find pcsx2, look at PID, then find AppRun, select near pcsx2 PID (Example : PCSX2 7064, AppRun in 7060)\n\n-Use Left or Right Arrow to make more easier hide or show group code.\n\n\"Rebuild from CE to PINCE by Rasputin-Walnut90.1\"", "bookmarks": {}, "address_tree": [["READ NOTES!!!", "WARNING", [11, 10, true, 0, 0], []], ["PCSX2 RAM Detector", "", [2, 10, true, 0, 0], {"script": "import os\nimport sys\n\ndef find_pcsx2_deleted_zero_base():\n    \"\"\"Mencari base address /dev/shm/pcsx2_* (deleted) [0]\"\"\"\n    for entry in os.listdir(\"/proc\"):\n        if not entry.isdigit():\n            continue\n        maps_path = f\"/proc/{entry}/maps\"\n        if not os.path.exists(maps_path):\n            continue\n        try:\n            with open(maps_path, \"r\") as f:\n                for line in f:\n                    if \"/dev/shm/pcsx2_\" in line and \"(deleted)\" in line and \" 00000000 \" in line:\n                        start_hex = line.split()[0].split(\"-\")[0]\n                        return int(start_hex, 16), int(entry)\n        except (PermissionError, FileNotFoundError):\n            continue\n    return None, None\n\ndef set_ee_mem_via_loaded_modules(hex_addr):\n    \"\"\"\n    Mengakses modul GDB atau QApplication yang sudah ter-load di memori (sys.modules)\n    \"\"\"\n    gdb_cmd = f\"set $pcsx2_ram = {hex_addr}\"\n    \n    # 1. Coba eksekusi langsung melalui modul gdb_engine yang ada di sys.modules\n    for mod_name, mod in list(sys.modules.items()):\n        if mod and (\"gdb\" in mod_name.lower() or \"libpince\" in mod_name.lower()):\n            for attr_name in [\"execute_command\", \"send_command\", \"execute_gdb_command\"]:\n                if hasattr(mod, attr_name):\n                    try:\n                        func = getattr(mod, attr_name)\n                        if callable(func):\n                            func(gdb_cmd)\n                            print(f\"[+] Executed via sys.modules['{mod_name}'].{attr_name}()\")\n                            return True\n                    except Exception:\n                        pass\n\n    # 2. Coba cari QApplication dari sys.modules (PyQt5/PySide2/PyQt6)\n    qapp = None\n    for mod_name in list(sys.modules.keys()):\n        if \"qtwidgets\" in mod_name.lower():\n            qt_mod = sys.modules[mod_name]\n            if hasattr(qt_mod, \"QApplication\"):\n                qapp = qt_mod.QApplication.instance()\n                if qapp:\n                    break\n\n    if qapp:\n        for widget in qapp.topLevelWidgets():\n            for attr in [\"gdb_engine\", \"gdb\", \"GDB\", \"gdb_wrapper\"]:\n                if hasattr(widget, attr):\n                    gdb_obj = getattr(widget, attr)\n                    for method_name in [\"execute_command\", \"send_command\", \"execute\"]:\n                        if hasattr(gdb_obj, method_name):\n                            try:\n                                getattr(gdb_obj, method_name)(gdb_cmd)\n                                print(f\"[+] Executed via GUI Widget.{attr}.{method_name}()\")\n                                return True\n                            except Exception:\n                                pass\n    return False\n\ndef main():\n    print(\"[*] Memindai region memori /dev/shm/pcsx2_* (deleted) [0]...\")\n    base_addr, pid = find_pcsx2_deleted_zero_base()\n\n    if not base_addr:\n        print(\"[!] Region memori spesifik tidak ditemukan. Pastikan game PCSX2 sedang berjalan!\")\n        return\n\n    hex_addr = hex(base_addr)\n    print(f\"[+] Ditemukan PID: {pid}\")\n    print(f\"[+] Alamat Biru: {hex_addr}\")\n\n    if set_ee_mem_via_loaded_modules(hex_addr):\n        print(f\"[+] BERHASIL: $pcsx2_ram pada GDB PINCE di-set ke {hex_addr}\")\n    else:\n        print(\"[!] Gagal menemukan fungsi eksekusi GDB di memori PINCE.\")\n\nmain()\nprint(f\"[v] Dibuat dengan cinta | Made with Love by Rasputin-Walnut90.1\")"}, []], ["Base", "$pcsx2_ram", [11, 10, true, 0, 0], [["Player 1 Stats", "+0x0", [11, 10, true, 0, 0], [["Health (P1 1)", "+0x4BC4C0", [4, 10, true, 0, 1], []], ["Health (P1 2)", "+0x4BC4C8", [4, 10, true, 0, 1], []], ["Head HP (P1)", "+0x4bc990", [4, 10, true, 0, 1], []], ["Arm HP (P1)", "+0x4bc998", [4, 10, true, 0, 1], []], ["Leg HP (P1)", "+0x4bc99c", [4, 10, true, 0, 1], []]]], ["Player 2 Stats", "+0x0", [11, 10, true, 0, 0], [["Health (P2 1)", "+0x4bd7c0", [4, 10, true, 0, 1], []], ["Health (P2 2)", "+0x4bd7b8", [4, 10, true, 0, 1], []], ["Head HP (P2)", "+0x4bdc88", [4, 10, true, 0, 1], []], ["Arm HP (P2)", "+0x4bdc90", [4, 10, true, 0, 1], []], ["Leg HP (P2)", "+0x4bdc94", [4, 10, true, 0, 1], []]]], ["User Stats", "+0x0", [11, 10, true, 0, 0], [["SaveFile 1", "+0x0", [11, 10, true, 0, 0], [["Dev Point", "+0x8EC208", [2, 10, true, 0, 1], []], ["Money", "+0x8ec200", [2, 10, true, 0, 1], []], ["Block", "+0x8ec258", [2, 10, true, 0, 1], []], ["Counter Block", "+0x8ec25c", [1, 10, true, 1, 1], []], ["Grapple Moves", "+0x8ec262", [1, 10, true, 1, 1], []], ["Crowd Double Team", "+0x8ec264", [1, 10, true, 1, 1], []], ["Blazin", "+0x8ec27c", [1, 10, true, 1, 1], []], ["KO", "+0x8ec27e", [1, 10, true, 1, 1], []]]]]], ["Weapon Grabbed (SaveFile 1)", "+0x0", [11, 10, true, 0, 0], [["Pool Stick", "+0x8ec270", [12, 1, 0, 0], []], ["Pool Stick", "+0x8ec270", [12, 1, 1, 0], []], ["Shiny Shovel", "+0x8ec270", [12, 1, 2, 0], []], ["Rusty Shovel", "+0x8ec270", [12, 1, 3, 0], []], ["Broom", "+0x8ec270", [12, 1, 4, 0], []], ["Broom", "+0x8ec270", [12, 1, 5, 0], []], ["Baseball Bat", "+0x8ec270", [12, 1, 6, 0], []], ["Muffler", "+0x8ec271", [12, 1, 0, 0], []], ["Tire Iron", "+0x8ec271", [12, 1, 2, 0], []], ["Tire Iron", "+0x8ec271", [12, 1, 3, 0], []], ["Small Pipe", "+0x8ec271", [12, 1, 4, 0], []], ["Small Pipe", "+0x8ec271"